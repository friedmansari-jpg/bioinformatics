alignment

print(alignment, show = "complete")

A <- as.matrix(alignment)
gap_count <- sum(A == "-")
gap_count

alignment_length <- ncol(A)
alignment_length

letter_counts <- table(A)
letter_counts

G <- ifelse("G" %in% names(letter_counts), letter_counts["G"], 0)
C <- ifelse("C" %in% names(letter_counts), letter_counts["C"], 0)


total_bases <- sum(letter_counts) -
ifelse("-" %in% names(letter_counts), letter_counts["-"], 0)

GC_content <- (G + C) / total_bases * 100
GC_content

library(msa)
library(seqinr)

alignment_seqinr <- msaConvert(alignment, type = "seqinr::alignment")
alignment_seqinr

distancematrix <- dist.alignment(alignment_seqinr, "identity")
distancematrix

aligned <- as(alignment, "DNAStringSet")
aligned
A <- as.matrix(aligned)

n <- nrow(A)
D <- matrix(NA, n, n, dimnames = list(names(aligned), names(aligned)))

for (i in 1:n) {
  for (j in i:n) {
    valid <- A[i,] %in% c("A","T","G","C") & A[j,] %in% c("A","T","G","C")
    pid <- sum(A[i, valid] == A[j, valid]) / sum(valid)
    D[i, j] <- D[j, i] <- 1 - pid
  }
}
D

diag(D) <- NA

closest <- which(D == min(D, na.rm=TRUE), arr.ind=TRUE)[1,]
farthest <- which(D == max(D, na.rm=TRUE), arr.ind=TRUE)[1,]

c("closest", rownames(D)[closest[1]], colnames(D)[closest[2]], D[closest[1], closest[2]])
c("farthest", rownames(D)[farthest[1]], colnames(D)[farthest[2]], D[farthest[1], farthest[2]])

